# Core

# DashScope: embeddings + summary/facts generation
DASHSCOPE_API_KEY="your-dashscope-api-key"
DASHSCOPE_BASE_HTTP_API_URL="https://your-workspace-id.cn-beijing.maas.aliyuncs.com/api/v1"
# Do not use https://dashscope.aliyuncs.com/compatible-mode/v1 here; that URL is for OpenAI-compatible clients.
KB_TEXT_LLM_MODEL="qwen-plus"
KB_EMBEDDING_MODEL="qwen3-vl-embedding"
KB_IMAGE_TAGGING_MODEL="qwen3-vl-plus"
# Embedding request protection:
# - normal max concurrency
# - provider rate-limit cooldown window
KB_EMBEDDING_MAX_CONCURRENCY="10"
KB_EMBEDDING_RATE_LIMIT_COOLDOWN_SECONDS="60"

# Vector store settings
KB_VECTOR_STORE="milvus"

# Milvus Lite / app settings
KB_MILVUS_URI="./data/milvus.db"
KB_COLLECTION_NAME="documents"

# Qdrant settings. Set KB_VECTOR_STORE="qdrant" to use these.
KB_QDRANT_URL="http://127.0.0.1:6333"
KB_QDRANT_API_KEY=""
KB_QDRANT_COLLECTION_NAME="documents"
KB_QDRANT_FACTS_COLLECTION_NAME="documents_facts"
KB_QDRANT_ON_DISK_VECTORS="true"
KB_QDRANT_TIMEOUT_SECONDS="10"

KB_CHUNK_SIZE="1200"
KB_CHUNK_OVERLAP="150"
KB_DEFAULT_TOP_K="5"
KB_MILVUS_FILTER_BATCH_SIZE="200"
KB_MILVUS_ITERATOR_BATCH_SIZE="100"
KB_MILVUS_WRITE_BATCH_SIZE="100"
KB_VECTOR_SEARCH_MAX_CONCURRENCY="1"
KB_MILVUS_SEARCH_MAX_CONCURRENCY="1"
KB_LOG_LEVEL="INFO"
KB_LOG_DIR="./logs"
KB_UPLOAD_STAGING_DIR="./data/upload_staging"
KB_BRAND_FULL_KNOWLEDGE_REFRESH_DELAY_SECONDS="300"
KB_CATEGORY_LATEST_CACHE_TTL_SECONDS="480"
KB_BRAND_PATHS_LOAD_CACHE_TTL_SECONDS="600"
KB_BRAND_PATHS_LOAD_CACHE_MAX_ENTRIES="100"
KB_PATH_INDEX_SUMMARY_CACHE_MAX_ENTRIES="800"


# OSS

OSS_ENDPOINT="oss-cn-beijing.aliyuncs.com"
OSS_BUCKET_NAME="your-bucket-name"
OSS_REGION="cn-beijing"
OSS_ACCESS_KEY_ID="your-oss-access-key-id"
OSS_ACCESS_KEY_SECRET="your-oss-access-key-secret"
# Optional object-key prefix. Use "test" to isolate uploads under test/.
OSS_OBJECT_KEY_PREFIX=""


# MySQL


MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD="your-mysql-password"
MYSQL_DATABASE="knowledge_base"


# DocMind fallback
# Triggered only when local parsing fails or extracts no text

KB_DOCMIND_ENABLED="true"
KB_DOCMIND_ENDPOINT="docmind-api.cn-hangzhou.aliyuncs.com"

# Preferred: use dedicated DocMind/Alibaba Cloud credentials
DOCMIND_ACCESS_KEY_ID="your-docmind-access-key-id"
DOCMIND_ACCESS_KEY_SECRET="your-docmind-access-key-secret"

KB_DOCMIND_TIMEOUT_SECONDS="300"
KB_DOCMIND_POLL_INTERVAL_SECONDS="3"
KB_DOCMIND_DOWNLOAD_TIMEOUT_SECONDS="60"
KB_DOCMIND_LLM_ENHANCEMENT="true"
KB_DOCMIND_ENHANCEMENT_MODE="VLM"

# ========== 飞书通知 ==========
BUSINESS_ALERTS_ENABLED="true"
BUSINESS_ALERT_NOTIFY_URL="https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx"
BUSINESS_ALERT_NOTIFY_KEY=
BUSINESS_ALERT_TIMEOUT_SECONDS=10

#=========== 上传文件完成回调 ========
BRAND_COMPLETION_CALLBACK_URL="http://你的回调服务地址"

#=========== AI知识库生成 ========
# 可选值：anthropic / local
KB_BRAND_PATCH_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=你的_claude_api_key
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# 当 KB_BRAND_PATCH_LLM_PROVIDER=local 时使用 OpenAI Chat Completions 兼容接口
KB_LOCAL_LLM_BASE_URL=http://192.168.1.68:9111/v1/chat/completions
KB_LOCAL_LLM_MODEL=expert
KB_LOCAL_LLM_API_KEY=

#=========== 天眼查补空字段（可选） ========
KB_TIANYANCHA_ENABLED="false"
KB_TIANYANCHA_API_KEY="your-tianyancha-api-key"
KB_TIANYANCHA_MCP_URL="https://mcp.tianyancha.com/v1"
KB_TIANYANCHA_TIMEOUT_SECONDS="15"
